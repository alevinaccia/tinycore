// Tang Nano 20K, check against your working button cst
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

//buttons
IO_LOC "s1" 88;
IO_PORT "s1" IO_TYPE=LVCMOS33;
IO_LOC "s2" 87;
IO_PORT "s2" IO_TYPE=LVCMOS33;
IO_LOC "keyboard[0]" 72;
IO_PORT "keyboard[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "keyboard[1]" 71;
IO_PORT "keyboard[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "keyboard[2]" 26;
IO_PORT "keyboard[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "keyboard[3]" 29;
IO_PORT "keyboard[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// buzzer
IO_LOC "buzz" 79;
IO_PORT "buzz" IO_TYPE=LVCMOS33 DRIVE=8;

// lcd
IO_LOC "lcd_rs" 30;
IO_PORT "lcd_rs" IO_TYPE=LVCMOS33;
IO_LOC "lcd_en" 31;
IO_PORT "lcd_en" IO_TYPE=LVCMOS33;
IO_LOC "lcd_data[0]" 17;
IO_PORT "lcd_data[0]" IO_TYPE=LVCMOS33;
IO_LOC "lcd_data[1]" 20;
IO_PORT "lcd_data[1]" IO_TYPE=LVCMOS33;
IO_LOC "lcd_data[2]" 19;
IO_PORT "lcd_data[2]" IO_TYPE=LVCMOS33;
IO_LOC "lcd_data[3]" 18;
IO_PORT "lcd_data[3]" IO_TYPE=LVCMOS33;

// pmw
IO_LOC "pwm_en" 86;
IO_PORT "pwm_en" IO_TYPE=LVCMOS33;
IO_LOC "pwm_pwr" 49;
IO_PORT "pwm_pwr" IO_TYPE=LVCMOS33;
IO_LOC "pwm_gnd" 55;
IO_PORT "pwm_gnd" IO_TYPE=LVCMOS33;

// dac
IO_LOC "dac_ctrl[0]" 75;
IO_LOC "dac_ctrl[1]" 80;
IO_LOC "dac_ctrl[2]" 76;
IO_LOC "dac_ctrl[3]" 42;
IO_LOC "dac_ctrl[4]" 77;
IO_LOC "dac_ctrl[5]" 73;
IO_LOC "adc_cmp"     27;

// leds
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;

// uart
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
